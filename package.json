{
  "name": "@arcaneorion/dsh-tui",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "dsh-tui": "./bin/dsh-tui.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./startup": "./src/startup.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "description": "DeepSeek Harness terminal front door built from scratch on @earendil-works/pi-tui: imperative string-array components, fully replaceable UI surfaces, dsh kernel underneath.",
  "license": "MIT",
  "author": "arcanexis",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "tui",
    "terminal",
    "pi-tui"
  ],
  "files": [
    "src",
    "bin",
    "scripts",
    "docs",
    "cordis.patch.yml",
    "presets",
    "README.md",
    "AUDIT.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "audit": "node scripts/audit.mjs",
    "check": "node --check src/index.js && node --check src/app.js && node --check src/kernel.js && node --check src/projection.js && node --check src/registry.js && node --check src/messages.js && node --check src/theme.js && node --check src/host.js && node --check src/startup.js && node --check src/workbench.js && node --check src/document.js && node --check src/composer.js && node --check src/edit-pane.js && node --check src/layout.js && node --check src/prompts.js && node --check src/footer.js && node --check src/interactive.js && node --check src/mentions.js && node --check src/session-switch.js && node --check src/file-changes.js && node --check src/workspace-changes.js",
    "demo": "node scripts/demo.mjs",
    "demo:files": "node scripts/demo.mjs --files",
    "preview:files": "node scripts/file-pane-preview.mjs",
    "design:preview": "node scripts/design-preview.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^0.82.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.1",
    "@deepseek-ai/dsh-agent-default-model": "0.2.0-rc.1",
    "@deepseek-ai/dsh-agent-preset": "0.2.0-rc.1",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.0-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.1",
    "@deepseek-ai/dsh-cmdline": "0.2.0-rc.1",
    "@deepseek-ai/dsh-file-reference": "0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/standard.patch.yml",
        "./presets/ptc.patch.yml",
        "./presets/minimal.patch.yml",
        "./presets/cordis.patch.yml"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/cordis-plugin-group": "~1.0.4",
    "@deepseek-ai/cordis-plugin-include": "~1.0.9",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.5",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.1",
    "@deepseek-ai/dsh-agent-default-model": "0.2.0-rc.1",
    "@deepseek-ai/dsh-agent-preset": "0.2.0-rc.1",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.0-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.1",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.1",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.1",
    "@deepseek-ai/dsh-file-reference": "0.2.0-rc.1",
    "@deepseek-ai/dsh-fs": "0.2.0-rc.1",
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.1",
    "@deepseek-ai/dsh-invariants": "0.2.0-rc.1",
    "@deepseek-ai/dsh-launch-environment": "0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.1",
    "@deepseek-ai/dsh-native-command": "0.2.0-rc.1",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session-query": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session-title": "0.2.0-rc.1",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.1",
    "@deepseek-ai/dsh-subagent": "0.2.0-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.1",
    "@deepseek-ai/dsh-typert-registry": "0.2.0-rc.1",
    "@deepseek-ai/dsh-util-time": "0.2.0-rc.1",
    "@deepseek-ai/dsh-util-values": "0.2.0-rc.1",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.0-rc.1"
  }
}
