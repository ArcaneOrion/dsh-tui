{
  "name": "@arcaneorion/dsh-tui",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "dsh-tui": "./bin/dsh-tui.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./startup": "./src/startup.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "description": "DeepSeek Harness terminal front door built from scratch on @earendil-works/pi-tui: imperative string-array components, fully replaceable UI surfaces, dsh kernel underneath.",
  "license": "MIT",
  "author": "arcanexis",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "tui",
    "terminal",
    "pi-tui"
  ],
  "files": [
    "src",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "AUDIT.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check src/index.js && node --check src/app.js && node --check src/kernel.js && node --check src/projection.js && node --check src/registry.js && node --check src/messages.js && node --check src/theme.js && node --check src/host.js && node --check src/startup.js"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^0.82.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.1",
    "@deepseek-ai/dsh-cmdline": "0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "0.2.0-rc.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.1",
    "@deepseek-ai/dsh-invariants": "0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.1",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.1"
  }
}
